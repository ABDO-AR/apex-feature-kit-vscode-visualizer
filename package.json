{
  "name": "apex-feature-kit-vscode-visualizer",
  "displayName": "Apex Feature Kit",
  "description": "Feature-Driven Development visualizer — sidebar tree + Mermaid flow diagram",
  "version": "0.1.0",
  "publisher": "abdoar",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apex-feature-kit",
          "title": "Apex Feature Kit",
          "icon": "resources/apex-activitybar.svg"
        }
      ]
    },
    "views": {
      "apex-feature-kit": [
        {
          "id": "apexFeatureTree",
          "name": "Features",
          "icon": "resources/icon.svg"
        },
        {
          "id": "apexInstructions",
          "name": "Instructions",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "apexFeatureTree",
        "contents": "No `.features/` directory found.\nRun `apex-feature-kit init all` to get started.\n[Show Instructions](command:apex.showInstructions)",
        "when": "!apex.hasFeatures"
      },
      {
        "view": "apexInstructions",
        "contents": "No `.features/instructions.md` found.\nRun `apex-feature-kit init all` to get started.\n[Show Instructions](command:apex.showInstructions)",
        "when": "!apex.hasFeatures"
      }
    ],
    "commands": [
      { "command": "apex.openFlow", "title": "Apex: Open Flow Diagram", "icon": "$(graph)" },
      { "command": "apex.refreshTree", "title": "Apex: Refresh Feature Tree", "icon": "$(refresh)" },
      { "command": "apex.openSpec", "title": "Apex: Open Feature Spec", "icon": "$(go-to-file)" },
      { "command": "apex.runSync", "title": "Apex: Run Sync", "icon": "$(sync)" },
      { "command": "apex.showInstructions", "title": "Apex: Show Instructions", "icon": "$(book)" }
    ],
    "menus": {
      "view/title": [
        { "command": "apex.refreshTree", "when": "view == apexFeatureTree", "group": "navigation@1" },
        { "command": "apex.openFlow", "when": "view == apexFeatureTree", "group": "navigation@2" },
        { "command": "apex.showInstructions", "when": "view == apexFeatureTree", "group": "navigation@3" },
        { "command": "apex.showInstructions", "when": "view == apexInstructions", "group": "navigation@1" }
      ],
      "view/item/context": [
        { "command": "apex.openSpec", "when": "view == apexFeatureTree && viewItem =~ /^feature/", "group": "inline@1" },
        { "command": "apex.runSync", "when": "view == apexFeatureTree && viewItem =~ /^feature/", "group": "inline@2" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
